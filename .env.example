# Copy to .env for local runs. Never commit real secrets.

CASEPACKET_LOCAL=1
DEMO_API_KEY=casepacket-demo-key
PORT=8080

# Optional: used by the Vite console when the API is not proxied
VITE_API_URL=http://127.0.0.1:8080
VITE_API_KEY=casepacket-demo-key

# AWS deploy only (set by SAM). Leave unset for local.
# TABLE_NAME=
# BUCKET_NAME=
# STATE_MACHINE_ARN=
# ENABLE_BEDROCK=0
# BEDROCK_MODEL_ID=amazon.titan-text-lite-v1
